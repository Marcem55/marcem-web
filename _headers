# Cabeceras de seguridad para Cloudflare Pages (equivalen a las que tenía vercel.json)
/*
  Strict-Transport-Security: max-age=63072000; includeSubDomains
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob:; connect-src 'self'; form-action 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; upgrade-insecure-requests

# La copia en *.pages.dev no se indexa: Google solo debe ver marcem.com.ar
https://:project.pages.dev/*
  X-Robots-Tag: noindex

# Propuestas de clientes, ficha y maquetas privadas: noindex también por cabecera
/propuesta-*
  X-Robots-Tag: noindex
/ficha
  X-Robots-Tag: noindex
/demo-estudio-juridico
  X-Robots-Tag: noindex
