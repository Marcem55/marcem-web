{
  "redirects": [
    { "source": "/:page([a-z0-9-]+).html", "destination": "https://marcem.com.ar/:page", "permanent": true },
    { "source": "/:path*", "destination": "https://marcem.com.ar/:path*", "permanent": true }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Robots-Tag", "value": "noindex" }
      ]
    }
  ]
}
